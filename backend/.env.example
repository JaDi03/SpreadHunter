ARC_RPC_URL=https://rpc.testnet.arc.network/
LLM_API_KEY=your_llm_api_key_here

# Circle W3S SDK (Developer-Controlled Wallets for autonomous trading)
# Create these in the Circle Developer Console
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_ENTITY_SECRET=your_circle_entity_secret_here

# Circle CCTP — source chain for bridging USDC into Arc Testnet
# NOTE: SOURCE_CHAIN_RPC_URL is only used as a fallback for the legacy manual bridge script (bridgeService.js).
# The WaaS multi-chain automatic bridge flow (walletManager.js) handles RPC connections internally.
SOURCE_CHAIN_RPC_URL=https://rpc.sepolia.org
ARC_MESSAGE_TRANSMITTER=0xYourArcMessageTransmitterAddressHere

# supabase configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here
DEMO_MODE=true
